{
  "manifest_version": 3,
  "name": "Floating Messenger",
  "version": "0.1.0",
  "description": "인스타그램 DM을 어떤 사이트에서든 플로팅 버블로 열어 보는 위젯 (텍스트 전용)",
  "minimum_chrome_version": "116",

  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "메신저 위젯 열기/닫기",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },

  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["lib/normalize.js", "ig-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://www.instagram.com/*"],
      "js": ["widget.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.css", "panel.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
